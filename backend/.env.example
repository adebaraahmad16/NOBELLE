# MySQL. Configure a real account; no data is seeded automatically.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/nobelle
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks using PAYSTACK_SECRET_KEY, not a separate secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_FROM=NOBELLE <no-reply@YOUR_DOMAIN>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
TRUST_PROXY=0
UPLOAD_DIR=./uploads
# Supply only during bootstrap, then remove.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
# Dedicated MySQL database name must end in _test.
TEST_DATABASE_URL=

# Optional separate mode credentials; never put secret keys in VITE variables.
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
# Match the currencies actually enabled by Paystack for this merchant.
PAYSTACK_SUPPORTED_CURRENCIES=NGN
