{
  "name": "nobelle-backend",
  "version": "1.0.0",
  "description": "NOBELLE commerce API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-build/tests/unit.test.js .test-build/tests/settings.test.js .test-build/tests/database.test.js .test-build/tests/settings.database.test.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test .test-build/tests/unit.test.js .test-build/tests/settings.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-build/tests/database.test.js .test-build/tests/settings.database.test.js"
  },
  "keywords": [
    "fashion",
    "ecommerce",
    "express",
    "prisma",
    "typescript",
    "paystack"
  ],
  "author": "NOBELLE",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/sanitize-html": "^2.16.2",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
    "prisma": "^6.4.1",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
